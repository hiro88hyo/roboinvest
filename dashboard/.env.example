# Supabase（ブラウザ・サーバー両方で参照）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SUPABASE_AUTH_PROVIDER=github

# 保守用または migration / batch 用。Dashboard の user-triggered path では使わない。
# NEXT_PUBLIC_ プレフィックスを付けないこと。
SUPABASE_SECRET_KEY=replace-with-local-service-role-key

# 表示タイムゾーン
NEXT_PUBLIC_APP_TIMEZONE=Asia/Tokyo
