GATEWAY_MODE=backtest
LOG_LEVEL=INFO
TZ=Asia/Tokyo

SUPABASE_URL=http://localhost:54321
SUPABASE_SECRET_KEY=replace-me

PUBSUB_PROJECT_ID=local-dev
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_SUBSCRIPTION_TRADE_SIGNALS=gateway-trade-signals
PUBSUB_TOPIC_LIVE_ORDERS=live-orders
PUBSUB_TOPIC_PAPER_ORDERS=paper-orders
PUBSUB_PULL_MAX_MESSAGES=100
PUBSUB_ACK_DEADLINE_SECONDS=30

CAPITAL=1000000
MAX_RISK_PER_TRADE_PCT=0.02
SWING_RISK_SCALE=0.5
DEFAULT_STOP_LOSS_SPREAD_PCT=0.02
MIN_LOT_SIZE=100
MARKET_REGIME_GATEWAY_LOG_ONLY_ENABLED=true
MARKET_REGIME_GATEWAY_GUARD_ENABLED=false
MARKET_REGIME_PAPER_GUARD_ENABLED=false
SOFT_LOSS_THROTTLE_LOG_ONLY_ENABLED=true
SOFT_LOSS_THROTTLE_GUARD_ENABLED=false
SOFT_LOSS_LIMIT_JPY=20000
EXECUTION_GATE_LOG_ONLY_ENABLED=true
EXECUTION_GATE_GUARD_ENABLED=false
EXECUTION_GATE_MAX_SPREAD_BPS=30
EXECUTION_GATE_MAX_SPREAD_TICKS=2
EXECUTION_GATE_MIN_ASK_DEPTH_MULTIPLIER=3

BACKTEST_OUTPUT_DIR=./out/gateway
