CONSENSUS_MIN_CONFIDENCE=0.3
CONFLICT_POLICY=skip
PAIRING_BUCKET_MS=1000
PAIRING_WINDOW_MS=1000
DEFAULT_HOLDING_TYPE=day

BACKTEST_OUTPUT_DIR=./out/aggregator
