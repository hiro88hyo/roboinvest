# services/universe-scanner/.env.example
# 値は開発環境のダミー。実値はコミットしない（.env は .gitignore 済み）。

# --- J-Quants API ---
JQUANTS_REFRESH_TOKEN=<your-refresh-token>
JQUANTS_PLAN=standard
JQUANTS_API_BASE=https://api.jquants.com/v1

# --- Supabase (infra/.env.example と揃える) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=<paste from `supabase start` output (sb_secret_...)>

# --- 静的フィルタ閾値 ---
SCAN_STATIC_MIN_TURNOVER_JPY=100000000
SCAN_STATIC_PRICE_MIN=300
SCAN_STATIC_PRICE_MAX=20000
# カンマ区切り (MarketCodeName ベース)
SCAN_STATIC_MARKET_SEGMENTS=プライム,スタンダード,グロース

# --- 動的スコアリング ---
SCAN_DYNAMIC_TOP_N=30
SCAN_LOOKBACK_DAYS=60
SCAN_WEIGHT_VOLATILITY=1.0
SCAN_WEIGHT_VOLUME_SURGE=1.0
SCAN_WEIGHT_MOMENTUM=1.0

# --- ランタイム ---
LOG_LEVEL=INFO
TZ=Asia/Tokyo
