OMS_LIVE_MODE=stream
LOG_LEVEL=INFO

KABU_API_BASE_URL=http://localhost:18081/kabusapi
KABU_API_PASSWORD=replace-me
KABU_ORDER_PASSWORD=replace-me
KABU_DEFAULT_EXCHANGE=9
KABU_ACCOUNT_TYPE=4
KABU_HTTP_TIMEOUT_SECONDS=10.0

SUPABASE_URL=http://localhost:54321
SUPABASE_SECRET_KEY=replace-me

PUBSUB_PROJECT_ID=local-dev
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_SUBSCRIPTION_LIVE_ORDERS=oms-live-live-orders
PUBSUB_PULL_MAX_MESSAGES=100
PUBSUB_ACK_DEADLINE_SECONDS=30

DAY_CLOSEOUT_TIME=14:50
DAY_CLOSEOUT_TIMEZONE=Asia/Tokyo

ORDER_FILL_POLL_INTERVAL_SECONDS=1.0
ORDER_FILL_TIMEOUT_SECONDS=30.0

# --- Phase 3 safety knobs (本番投入前のセーフティネット) ---
# 1 注文あたりの最大株数。空欄なら無制限 (従来挙動)。closeout では適用しない
OMS_LIVE_MAX_QTY_PER_ORDER=
# カンマ区切りの許可銘柄。空欄なら全銘柄許可。closeout では適用しない
# 例: OMS_LIVE_ALLOWED_SYMBOLS=7203,9984
OMS_LIVE_ALLOWED_SYMBOLS=
# true なら sendorder せず log だけ出して ack。Supabase 書込もしない。closeout も no-op
OMS_LIVE_DRY_RUN=false
