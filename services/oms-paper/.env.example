OMS_PAPER_MODE=backtest
LOG_LEVEL=INFO
TZ=Asia/Tokyo

SUPABASE_URL=http://localhost:54321
SUPABASE_SECRET_KEY=replace-me

PUBSUB_PROJECT_ID=local-dev
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_SUBSCRIPTION_PAPER_ORDERS=oms-paper-paper-orders
PUBSUB_SUBSCRIPTION_RAW_MARKET_DATA=oms-paper-raw-market-data
PUBSUB_PULL_MAX_MESSAGES=100
PUBSUB_ACK_DEADLINE_SECONDS=30
ORDER_BOOK_MAX_AGE_SECONDS=10
ORDER_BOOK_MAX_FUTURE_SKEW_SECONDS=5
# production は true。legacy/replay 互換が必要な local のみ false を許容。
# PAPER_ONLY は false でも received_at 必須。
ORDER_BOOK_REQUIRE_RECEIVED_AT=false

DAY_CLOSEOUT_TIME=14:50
DAY_CLOSEOUT_TIMEZONE=Asia/Tokyo

BACKTEST_OUTPUT_DIR=./out/oms-paper
