FEEDER_MODE=stream
LOG_LEVEL=INFO
TZ=Asia/Tokyo

KABU_API_BASE_URL=http://localhost:18081/kabusapi
KABU_WS_URL=ws://localhost:18081/kabusapi/websocket
KABU_API_PASSWORD=replace-me
KABU_DEFAULT_EXCHANGE=1
KABU_HTTP_TIMEOUT_SECONDS=10.0
# WS keepalive ping (未設定なら client-side ping は無効。kabu/Caddy は pong を
# 返さないことが本番疎通で観測されたためデフォルト無効。タイムアウト発火を
# 試したい場合のみ値を入れる)
# KABU_WS_PING_INTERVAL_SECONDS=20.0
# KABU_WS_PING_TIMEOUT_SECONDS=20.0

SUPABASE_URL=http://localhost:54321
SUPABASE_SECRET_KEY=replace-me

PUBSUB_PROJECT_ID=local-dev
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_TOPIC_RAW_MARKET_DATA=raw-market-data
PUBSUB_PUBLISH_TIMEOUT_SECONDS=30.0

WATCHLIST_POLL_INTERVAL_SECONDS=60.0

RECONNECT_INITIAL_BACKOFF_SEC=1.0
RECONNECT_MAX_BACKOFF_SEC=60.0
