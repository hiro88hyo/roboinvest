STRATEGY_RULE_MODE=backtest
LOG_LEVEL=INFO
TZ=Asia/Tokyo

SUPABASE_URL=http://localhost:54321
SUPABASE_SECRET_KEY=replace-me

PUBSUB_PROJECT_ID=local-dev
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_SUBSCRIPTION_FEATURES=strategy-rule-processed-features
PUBSUB_TOPIC_SIGNALS=strategy-signals-a
PUBSUB_PULL_MAX_MESSAGES=100
PUBSUB_ACK_DEADLINE_SECONDS=30

STRATEGIES_ENABLED=sma_crossover,rsi_threshold,bollinger_breakout

SMA_MIN_GAP_RATIO=0.0
RSI_BUY_THRESHOLD=30.0
RSI_SELL_THRESHOLD=70.0
BOLLINGER_BREAKOUT_TOLERANCE=0.0

BACKTEST_OUTPUT_DIR=./out/strategy-rule
