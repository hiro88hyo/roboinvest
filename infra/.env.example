# infra/.env.example
# 全サービス共通の環境変数テンプレート。
# `cp infra/.env.example .env` して使用。.env はコミット禁止。

# --- Supabase (ローカル: `supabase start` の出力値を貼り付け) ---
# 旧 anon / service_role (JWT) は deprecated。新形式 sb_publishable_... / sb_secret_... を使用。
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=<paste from `supabase start` output (sb_publishable_...)>
SUPABASE_SECRET_KEY=<paste from `supabase start` output (sb_secret_...)>

# --- Pub/Sub エミュレータ ---
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=trade-ai-dev

# --- システム全体 ---
# `live` | `paper`。起動時に system_status.trade_mode を初期化する。
TRADE_MODE=paper

# --- ロギング ---
LOG_LEVEL=INFO
