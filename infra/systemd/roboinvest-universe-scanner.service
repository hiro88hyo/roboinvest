[Unit]
Description=Run RoboInvest Universe Scanner batch
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
Type=oneshot
Environment=PATH=/home/hiroyuki/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/hiroyuki/workspaces/roboinvest
ExecStart=/usr/bin/env bash /home/hiroyuki/workspaces/roboinvest/scripts/run-production-universe-scanner.sh
Restart=on-failure
RestartSec=60s
Nice=10
